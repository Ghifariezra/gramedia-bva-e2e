{
    "variable": "register form email field length",
    "fixed": {
        "email": "bva.tester@example.com"
    },
    "emailMin": 1,
    "emailMax": 254,
    "emailMinCases": [
        {
            "id": "AUTH-BVA-E04",
            "description": "Empty email (min-1) keeps the Daftar button disabled",
            "length": 0,
            "class": "invalid",
            "expect": "rejected",
            "expectedSubmitEnabled": false
        },
        {
            "id": "AUTH-BVA-E05",
            "description": "Email with 1 character (min) enables the Daftar button (email format is not validated by the button state)",
            "length": 1,
            "class": "valid",
            "expect": "accepted",
            "expectedSubmitEnabled": true
        },
        {
            "id": "AUTH-BVA-E06",
            "description": "Email with 2 characters (min+1) enables the Daftar button (email format is not validated by the button state)",
            "length": 2,
            "class": "valid",
            "expect": "accepted",
            "expectedSubmitEnabled": true
        }
    ],
    "emailCases": [
        {
            "id": "AUTH-BVA-E01",
            "description": "Typing 253 characters in email (max-1) keeps all 253 characters and enables the Daftar button",
            "length": 253,
            "class": "valid",
            "expect": "accepted",
            "expectedLength": 253
        },
        {
            "id": "AUTH-BVA-E02",
            "description": "Typing 254 characters in email (max) keeps all 254 characters and enables the Daftar button",
            "length": 254,
            "class": "valid",
            "expect": "accepted",
            "expectedLength": 254
        },
        {
            "id": "AUTH-BVA-E03",
            "description": "Typing 255 characters in email (max+1) is truncated to 254 characters in the input",
            "length": 255,
            "class": "invalid",
            "expect": "truncated",
            "expectedLength": 254
        }
    ]
}
